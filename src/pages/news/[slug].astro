---
/**
 * Страница материала: /news/<slug>/.
 *
 * Раздел обязан быть в пути. Плоский /<slug>/ ставил статью в один ряд со
 * служебными страницами: сегментировать по разделу нельзя ни в аналитике,
 * ни в отчётах поиска, и краулеру иерархия тоже не видна.
 *
 * Рубрика в путь НЕ входит. Рубрику материала можно переназначить, а URL
 * после публикации меняться не должен.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecircList from '../../components/RecircList.astro';
import Hero from '../../components/Hero.astro';
import { ROUTES } from '../../lib/routes.mjs';
import { formatDayLong, AUTHOR } from '../../lib/seo.mjs';
import { CATEGORIES, relatedNews, sortNews, newsCard } from '../../lib/news.mjs';
import { mostActive } from '../../lib/related.mjs';
import { snapshotMeta } from '../../lib/incidents.mjs';

export async function getStaticPaths() {
  const all = await getCollection('news');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const cat = CATEGORIES[d.category];

const related = relatedNews(entry, all, 5);
const sameCategory = sortNews(all.filter((x) => x.id !== entry.id && x.data.category === d.category))
  .slice(0, 4).map(newsCard);

const crumbs = [
  { label: 'Home', href: ROUTES.home() },
  { label: 'News', href: ROUTES.news() },
  { label: cat.label, href: ROUTES.category(d.category) },
  { label: d.h1, href: ROUTES.article(entry.id) },
];

const schemas = [{
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.h1,
  description: d.description,
  datePublished: d.published,
  dateModified: d.published,
  articleSection: cat.label,
  author: { '@type': 'Organization', name: AUTHOR },
  publisher: { '@type': 'Organization', name: 'Marsad Cyber' },
  isAccessibleForFree: true,
}];
---
<BaseLayout
  title={d.title}
  description={d.description}
  crumbs={crumbs}
  schemas={schemas}
  current={{ kind: 'news', slug: entry.id }}
>
  <div class="page-head">
    <h1>{d.h1}</h1>
    <div class="byline">
    <a class="byline__tag" href={ROUTES.category(d.category)}>{cat.label}</a>
    <span class="byline__sep">/</span>
    <span class="byline__by"><span class="byline__monogram" aria-hidden="true">MC</span>By <a href={ROUTES.about()}>{AUTHOR}</a></span>
    <span class="byline__sep">/</span>
    <a href={ROUTES.archive(d.published.slice(0, 4), d.published.slice(5, 7))}>
      <time datetime={d.published}>{formatDayLong(d.published)}</time>
    </a>
    <span class="byline__sep">/</span>
      <span>{d.tier === 'T1' ? 'Brief' : 'Analysis'}</span>
    </div>
    <p class="lede">{d.dek}</p>
  </div>

  <div class="section" style="padding-bottom:var(--s3)">
    <Hero slug={d.image} />
  </div>

  <div class="prose guide-body"><Content /></div>

  <section class="sources">
    <h2 class="recirc__title">Sources</h2>
    <ul>
      {d.sources.map((s) => (
        <li>
          {s.href.startsWith('http')
            ? <a href={s.href} rel="noopener">{s.label}</a>
            : <a href={s.href}>{s.label}</a>}
        </li>
      ))}
      <li>
        Snapshot taken <time datetime={snapshotMeta.fetchedAt}>{formatDayLong(snapshotMeta.fetchedAt.slice(0, 10))}</time>,
        <a href={ROUTES.methodology()}> method and limitations</a>.
      </li>
    </ul>
  </section>

  <RecircList title="Related coverage" items={related} more={{ href: ROUTES.news() }} />
  <RecircList title={`More from ${cat.label}`} items={sameCategory} more={{ href: ROUTES.category(d.category) }} />
  <RecircList title="Most targeted sectors" items={mostActive(5)} />
</BaseLayout>
