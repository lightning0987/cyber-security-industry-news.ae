---
/**
 * Блок рециркуляции по ТЗ 14.2.
 *
 * Якорь строки выбирается один на весь блок, а не на строку. Когда у части
 * элементов фотография есть, а у части нет, список выглядит сломанным, и это
 * ровно то, что было на «Most targeted sectors»: секторы несли снимки, группы
 * нет. Фотографии групп у нас не существует и придумывать её нельзя, поэтому
 * правило простое: миниатюры показываются, только если они есть у всех.
 *
 * Голое число читателю ничего не говорит, поэтому под ним всегда стоит
 * единица измерения.
 */
const { title, items, more } = Astro.props;
const withThumbs = items.length > 0 && items.every((i) => i.thumb);
---
{items.length > 0 && (
  <section class="recirc">
    <h2 class="recirc__title">
      {more ? <a href={more.href} style="text-decoration:none">{title}</a> : title}
    </h2>
    <ul class="recirc-list">
      {items.map((item) => (
        <li>
          <a href={item.href}>
            {withThumbs
              ? <img class="recirc-thumb" src={item.thumb} alt={item.thumbAlt ?? ''} width="88" height="50" loading="lazy" decoding="async" />
              : (
                <span class="recirc-item__fig">
                  <span class="recirc-item__num">{item.figure}</span>
                  {item.figureLabel && <span class="recirc-item__unit">{item.figureLabel}</span>}
                </span>
              )}
            <span>
              <span class="recirc-item__title">{item.title}</span>
              <span class="recirc-item__meta">
                {item.meta}{item.overlap ? ` · ${item.overlap} shared claims` : ''}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
