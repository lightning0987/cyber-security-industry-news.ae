{
  "name": "marsad-cyber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "fetch:ransomware": "node scripts/fetch-ransomware-live.mjs",
    "fetch:all": "npm run fetch:ransomware",
    "check:data": "node scripts/check-data.mjs",
    "build:astro": "astro build",
    "verify": "node scripts/verify.mjs",
    "build": "npm run check:data && npm run lint:content && npm run build:astro && npm run verify",
    "lint": "astro check && node scripts/check-data.mjs --lint-imports",
    "ci": "npm run lint && npm run build",
    "briefs": "node scripts/export-content-briefs.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "check:health": "node scripts/health-check.mjs"
  },
  "dependencies": {
    "astro": "^7.3.2",
    "linkedom": "^0.18.13"
  }
}
